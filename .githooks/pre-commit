#!/usr/bin/env bash
# pre-commit hook: 涉及 skills/ 的提交自动跑知识库防腐校验
# 启用: git config core.hooksPath .githooks
if git diff --cached --name-only | grep -q '^skills/'; then
  echo "[skill-validate] 检测到 skills/ 变更, 运行防腐校验..."
  node skills/scripts/validate.mjs || {
    echo ""
    echo "[skill-validate] ✗ 校验未通过 — 修复以上错误后再提交"
    echo "  (若确认无误可跳过: git commit --no-verify)"
    exit 1
  }
  echo "[skill-validate] ✓ 通过"
fi
